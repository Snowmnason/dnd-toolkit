{
  "name": "dnd-toolkit",
  "main": "index.tsx",
  "version": "0.15.10",
  "homepage": "https://dnd-tool.thesnowpost.com/",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "lint:security": "eslint --ext .js,.jsx,.ts,.tsx app/ components/ lib/ hooks/ theme/ --quiet",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:critical": "npm audit --audit-level=critical",
    "security": "npm run audit && npm run lint:security",
    "security:full": "npm run audit:critical && npm run lint && npm run lint:security",
    "predeploy": "expo export -p web && node scripts/harden-web.js && node scripts/strip-dev-appsettings.js",
    "predeploy:desktop": "expo export -p web && node scripts/harden-web.js && node scripts/fix-desktop-paths.js && node scripts/strip-dev-appsettings.js",
    "deploy": "gh-pages -d dist --dotfiles",
    "deploy-dev": "gh-pages -d dist -b gh-pages-dev",
    "w": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:mobile": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:mobile": "eas submit --platform all",
    "desktop:install": "cd desktop && npm install",
    "desktop:build": "cd desktop && npm run build",
    "desktop:dev": "npm run predeploy:desktop && cd desktop && npm run dev",
    "desktop:dist": "npm run predeploy:desktop && cd desktop && npm run dist",
    "desktop:dist:win": "npm run predeploy:desktop && cd desktop && npm run dist:win",
    "desktop:dist:win:unsigned": "npm run predeploy:desktop && node scripts/build-desktop-unsigned.js win",
    "desktop:dist:mac": "npm run predeploy:desktop && cd desktop && npm run dist:mac",
    "desktop:dist:linux": "npm run predeploy:desktop && cd desktop && npm run dist:linux",
    "desktop:dist:all": "npm run predeploy:desktop && cd desktop && npm run dist:all",
    "clean": "node ./scripts/clean.js",
    "clean:desktop": "node ./scripts/clean.js desktop",
    "clean:web": "node ./scripts/clean.js web",
    "clean:deps": "node ./scripts/clean.js deps",
    "clean:cache": "node ./scripts/clean.js cache",
    "version:bump": "node ./scripts/bump-version.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-oauth/google": "^0.12.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.58.0",
    "aes-js": "^3.1.2",
    "color": "^5.0.2",
    "expo": "~54.0.31",
    "expo-apple-authentication": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "^14.0.10",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-router": "^6.0.21",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "^3.0.9",
    "expo-symbols": "^1.0.8",
    "expo-system-ui": "^6.0.9",
    "expo-web-browser": "^15.0.10",
    "react": "^19.1.0",
    "react-apple-signin-auth": "^1.1.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.70.0",
    "react-native": "0.81.5",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-security": "^3.0.1",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
