# Mobile Build Configuration - Fill in when ready to build
# See docs/BUILD.md for detailed instructions on obtaining these values

# ========================================
# iOS Signing & Deployment
# ========================================

# Apple ID for App Store Connect
APPLE_ID=""

# App-specific password (create at https://appleid.apple.com/account/security)
APPLE_PASSWORD=""

# Apple Team ID (from https://developer.apple.com/account/#/membership)
APPLE_TEAM_ID=""

# App Store Connect App ID (from App Store Connect)
ASC_APP_ID=""

# ========================================
# Android Signing & Deployment
# ========================================

# Android keystore password (for signing APK/AAB)
ANDROID_KEYSTORE_PASSWORD=""

# Android key password (for signing APK/AAB)
ANDROID_KEY_PASSWORD=""

# Path to service account JSON (for Google Play Console)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# ========================================
# EAS Build Configuration
# ========================================

# EAS Project ID (from eas.json or eas init output)
EAS_PROJECT_ID=""
