{
  "description": "Production settings. All dev features disabled, optimized for performance and security.",
  "environment": "production",
  "features": {
    "consoleLogging": false,
    "devBypass": false,
    "mockData": false,
    "performanceMonitoring": false,
    "sentryEnabled": false
  },
  "overrides": {
    "mockSupabase": false,
    "verboseErrorMessages": false
  },
  "devTools": {
    "enableConsoleLogger": false,
    "enableNetworkLogger": false,
    "enablePerformanceLogger": false,
    "enableReduxDevTools": false,
    "enableReactDevTools": false
  },
  "featureFlags": {
    "splashScreen": {
      "enabled": true,
      "description": "Show splash screen on app load (after bootstrap + 1s buffer)",
      "kind": "free"
    },
    "debugLogs": {
      "enabled": true,
      "description": "Enable verbose debug logging throughout the app - helps diagnose production issues",
      "kind": "free"
    },
    "loggerCategories": {
      "enabled": true,
      "description": "Configure which logger categories are enabled in production",
      "kind": "free",
      "categories": {
        "auth": false,
        "navigation": false,
        "api": false,
        "network": false,
        "performance": false,
        "storage": true,
        "ui": false,
        "analytics": false,
        "security": true,
        "bootstrap": false,
        "error": true,
        "other": false,
        "jobs": true
      }
    }
  },
  "backgroundJobs": {
    "reconnectDebounceMs": 1000,
    "pollIntervalMs": 5000,
    "description": "Job queue configuration (production: conservative, stable timings)"
  },
  "network": {
    "pingIntervalMs": 300000,
    "pingTimeoutMs": 5000,
    "statusCheckTimeoutMs": 30000,
    "description": "Network connectivity detection settings"
  },
  "api": {
    "requestTimeoutMs": 30000,
    "retryDelayMs": 1000,
    "staleTimeMs": 120000,
    "cacheTimeMs": 300000,
    "cleanupIntervalMs": 3600000,
    "staleThresholdMs": 3600000,
    "description": "Request manager and caching settings"
  },
  "sync": {
    "debounceMs": 5000,
    "retryBaseMs": 2000,
    "description": "Offline sync behavior (production: stable timings)"
  },
  "storage": {
    "cleanupIntervalMs": 300000,
    "description": "Cache cleanup interval (5 minutes)"
  },
  "ui": {
    "toastDurationMs": 2500,
    "syncToastDurationMs": 3000,
    "description": "UI notification durations"
  },
  "thresholds": {
    "slowScreenMs": 3000,
    "slowRequestMs": 3000
  },
  "safeMode": {
    "kernelTimeoutMs": 10000,
    "syncFailureThreshold": 3,
    "healthCheckIntervalMs": 30000,
    "autoRecoveryAttempts": 2,
    "autoRecoveryDelayMs": 5000,
    "description": "Safe mode health check configuration (production: conservative)"
  }
}
