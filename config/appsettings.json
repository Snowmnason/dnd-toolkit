{
  "description": "Production settings. All dev features disabled, optimized for performance and security.",
  "environment": "production",
  "features": {
    "consoleLogging": false,
    "devBypass": false,
    "mockData": false,
    "performanceMonitoring": false,
    "sentryEnabled": false
  },
  "overrides": {
    "mockSupabase": false,
    "verboseErrorMessages": false
  },
  "devTools": {
    "enableConsoleLogger": false,
    "enableNetworkLogger": false,
    "enablePerformanceLogger": false,
    "enableReduxDevTools": false,
    "enableReactDevTools": false
  },
  "featureFlags": {
    "splashScreen": {
      "enabled": true,
      "description": "Show splash screen on app load (after bootstrap + 1s buffer)",
      "kind": "free"
    },
    "debugLogs": {
      "enabled": true,
      "description": "Enable verbose debug logging throughout the app - helps diagnose production issues",
      "kind": "free"
    },
    "loggerCategories": {
      "enabled": true,
      "description": "Configure which logger categories are enabled in production",
      "kind": "free",
      "categories": {
        "auth": false,
        "navigation": false,
        "api": false,
        "network": false,
        "performance": false,
        "storage": true,
        "ui": false,
        "analytics": false,
        "security": true,
        "bootstrap": false,
        "error": true,
        "other": false
      }
    }
  },
  "thresholds": {
    "slowScreenMs": 3000,
    "slowRequestMs": 3000
  }
}
